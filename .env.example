# Claude (optional: without it the app uses a rule-based fallback)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# No Anthropic key? Any one of these works instead (OpenAI-compatible chat API with tool calling):
# GEMINI_API_KEY=            free at https://aistudio.google.com/apikey
# GROQ_API_KEY=              free at https://console.groq.com/keys
# LLM_API_KEY= / LLM_BASE_URL= / LLM_MODEL=   your own endpoint; LLM_MODEL also overrides the default model above

# PayPal sandbox app from https://developer.paypal.com/dashboard/applications/sandbox
# (optional: without them a local PayPal simulator is used)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the same app (Apps & Credentials > your app > Webhooks). Without it, incoming
# webhooks are refused, because their signatures can't be verified.
PAYPAL_WEBHOOK_ID=

PORT=3000
# Public URL PayPal redirects back to after approval (set this when deployed, e.g. on Render)
APP_URL=http://localhost:3000
